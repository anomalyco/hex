<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template: refreshes a local mirror of another Mac's Hex meetings every two
  minutes at background priority, for `hex mcp --meetings-dir`.

  Replace @REPO@ with the Hex checkout and @HOME@ with your home folder, then:
    sed -e "s|@REPO@|$PWD|g" -e "s|@HOME@|$HOME|g" scripts/launchd/hex-meetings-mirror.plist \
      > ~/Library/LaunchAgents/com.kitlangton.hex.meetings-mirror.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kitlangton.hex.meetings-mirror.plist
  Remove with:
    launchctl bootout gui/$(id -u)/com.kitlangton.hex.meetings-mirror
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kitlangton.hex.meetings-mirror</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>@REPO@/scripts/sync-meetings-mirror.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HEX_MEETINGS_HOST</key>
		<string>pro</string>
		<key>HEX_MEETINGS_MIRROR</key>
		<string>@HOME@/Library/Caches/hex-meetings-mirror</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/hex-meetings-mirror.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/hex-meetings-mirror.log</string>
</dict>
</plist>
