{
  "name": "hex-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/release-data.ts --mode dev && vite",
    "build": "bun scripts/build.ts",
    "preview": "vite preview",
