{
  "name": "hex-voice-site",
  "account_id": "19d80aa432b86d110c8e1480cf895f5c",
  "compatibility_date": "2026-07-19",
  "main": "./worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hex.kitlangton.dev", "custom_domain": true },
    // The retired second site; the worker redirects it to hex.kitlangton.dev.
    { "pattern": "hex.kitlangton.com", "custom_domain": true }
  ]
}
