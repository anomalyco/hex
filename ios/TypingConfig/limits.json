{
  "about": "The one table of typing-config limits (format 0). ios/scripts/build-typing-config.py generates TypingConfigLimits.swift (the phone's clamps), the package's scripts/limits.py (check_config.py) and typing-config.schema.json from it. Edit here only.",
  "format": "hex.typing-config",
  "version": 0,
  "file": {
    "maxBytes": 65536,
    "noteMaxCharacters": 280,
    "extension": "mhexconfig",
    "typeIdentifier": "anomaly.hex.typing-config",
    "conformsTo": "public.data"
  },
  "words": {
    "minLetters": 2,
    "maxLetters": 32,
    "keep": {
      "maxEntries": 500,
      "minTimes": 2,
      "minSessions": 2
    },
    "neverCorrectTo": {
      "maxEntries": 500,
      "minTakenBack": 2
    },
    "fixes": {
      "maxEntries": 500,
      "minTimes": 2,
      "minSessions": 2
    },
    "dictation": {
      "maxEntries": 200,
      "minTimes": 2,
      "maxWords": 3
    }
  },
  "keys": {
    "maxContexts": 8,
    "context": {
      "widthRound": 10,
      "geometryTolerance": 0.15
    },
    "aim": {
      "bound": 0.3,
      "minTunedTaps": 40,
      "minCheckedTaps": 20,
      "shrinkPrior": 20,
      "maxCheckDrift": 0.1,
      "sigmaX": 0.29,
      "sigmaY": 0.26,
      "minChange": 0.05
    },
    "zones": {
      "maxMove": 0.25,
      "keepFromCentre": 0.3,
      "minTunedTaps": 15,
      "minCheckedTaps": 10,
      "minNetCheckedWords": 2,
      "maxWrongShare": 0.34,
      "repair": {
        "letter": 0.75,
        "spaceAsLetter": 0.5,
        "letterAsSpace": 0.35,
        "otherKey": 0.25
      },
      "repairPrior": 10,
      "step": 0.05,
      "edges": {
        "letter": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "space": [
          "top",
          "left",
          "right"
        ],
        "layer:numbers": [
          "top",
          "right"
        ],
        "return": [
          "top",
          "left"
        ],
        "shift": [
          "top",
          "right"
        ],
        "delete": [
          "top",
          "left"
        ]
      }
    }
  }
}
