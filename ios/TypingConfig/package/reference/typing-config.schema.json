{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex.anomaly.co/typing-config/0.schema.json",
  "title": "Hex typing config, format 0",
  "description": "Generated by ios/scripts/build-typing-config.py from ios/TypingConfig/limits.json. Do not edit. Strict: what an agent must write. Hex itself reads leniently (reference/typing-config.md, \"Reading\").",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "basedOn",
    "madeFrom",
    "madeFor",
    "note"
  ],
  "properties": {
    "format": {
      "const": "hex.typing-config"
    },
    "version": {
      "const": 0
    },
    "id": {
      "type": "string",
      "pattern": "^cfg-[0-9a-f]{16}$"
    },
    "basedOn": {
      "type": [
        "string",
        "null"
      ]
    },
    "madeFrom": {
      "type": "object",
      "required": [
        "exportId",
        "hexVersion",
        "hexBuild",
        "logDays",
        "heldOut"
      ],
      "properties": {
        "exportId": {
          "type": "string"
        },
        "hexVersion": {
          "type": "string"
        },
        "hexBuild": {
          "type": "string"
        },
        "logDays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heldOut": {
          "type": "object",
          "required": [
            "tunedOn",
            "checkedOn"
          ],
          "properties": {
            "tunedOn": {
              "enum": [
                "A",
                "B"
              ]
            },
            "checkedOn": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        }
      }
    },
    "madeFor": {
      "type": "object",
      "required": [
        "device",
        "language"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 280
    },
    "words": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "word",
              "evidence"
            ],
            "properties": {
              "word": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32
              },
              "evidence": {
                "type": "object",
                "required": [
                  "times",
                  "sessions"
                ],
                "properties": {
                  "times": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sessions": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "neverCorrectTo": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "word",
              "evidence"
            ],
            "properties": {
              "word": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32
              },
              "evidence": {
                "type": "object",
                "required": [
                  "takenBack"
                ],
                "properties": {
                  "takenBack": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "fixes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "typo",
              "word",
              "mode",
              "evidence"
            ],
            "properties": {
              "typo": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32
              },
              "word": {
                "type": "string",
                "minLength": 2,
                "maxLength": 32
              },
              "mode": {
                "enum": [
                  "apply",
                  "suggest"
                ]
              },
              "evidence": {
                "type": "object",
                "required": [
                  "times",
                  "sessions"
                ],
                "properties": {
                  "times": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sessions": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "dictation": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heard",
              "meant",
              "evidence"
            ],
            "properties": {
              "heard": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "meant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "evidence": {
                "type": "object",
                "required": [
                  "times"
                ],
                "properties": {
                  "times": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "keys": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context"
        ],
        "properties": {
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "orientation",
              "posture",
              "language",
              "letters",
              "split",
              "hexPlacement",
              "numberRow",
              "keyHeight",
              "rowPitch",
              "letterWidth",
              "hitModel"
            ],
            "properties": {
              "width": {
                "type": "number"
              },
              "orientation": {
                "enum": [
                  "portrait",
                  "landscape"
                ]
              },
              "posture": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "letters": {
                "type": "string"
              },
              "split": {
                "type": "boolean"
              },
              "hexPlacement": {
                "type": "string"
              },
              "numberRow": {
                "type": "boolean"
              },
              "keyHeight": {
                "type": "number"
              },
              "rowPitch": {
                "type": "number"
              },
              "letterWidth": {
                "type": "number"
              },
              "hitModel": {
                "type": "integer"
              }
            }
          },
          "aim": {
            "type": "object",
            "propertyNames": {
              "pattern": "^.$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "offset",
                "evidence"
              ],
              "properties": {
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -0.3,
                    "maximum": 0.3
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "tuned",
                    "checked"
                  ],
                  "properties": {
                    "tuned": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "gained",
                        "lost"
                      ],
                      "properties": {
                        "taps": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gained": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "lost": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "checked": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "gained",
                        "lost"
                      ],
                      "properties": {
                        "taps": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gained": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "lost": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "edge",
                "move",
                "evidence"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "edge": {
                  "enum": [
                    "bottom",
                    "left",
                    "right",
                    "top"
                  ]
                },
                "move": {
                  "type": "number",
                  "minimum": -0.25,
                  "maximum": 0.25
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "tuned",
                    "checked"
                  ],
                  "properties": {
                    "tuned": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "gained",
                        "lost"
                      ],
                      "properties": {
                        "taps": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gained": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "lost": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "checked": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "gained",
                        "lost"
                      ],
                      "properties": {
                        "taps": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "gained": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "lost": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
