        "manifest": "base",
        "install": {
          "target": "windows-arm64",
          "distribution": "direct",
          "rollout_bucket": 0,
          "version": "0.0.0-dev-42",
          "channel": "dev"
        }
      },
      "expect": {
        "action": "none",
        "reason": "no_target"
      }
