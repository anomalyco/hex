        "install": {
          "target": "macos-arm64",
          "distribution": "direct",
          "rollout_bucket": 0,
          "version": "2.3.8"
        }
      },
      "expect": {
        "action": "install",
        "reason": "update",
        "version": "2.4.0",
        "target": {
          "url": "/release/example/files/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/example-2.4.0-macos-arm64.zip",
          "size": 1000,
