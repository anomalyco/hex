        }
      }
    },
    {
      "name": "malformed manifest",
      "input": {
        "app": "example",
        "artifact": "desktop",
        "channel": "stable",
        "manifest": "malformed",
        "install": {
          "target": "macos-arm64",
          "distribution": "direct",
          "rollout_bucket": 0,
          "version": "2.3.8"
        }
      },
      "expect": {
        "action": "reject",
        "reason": "malformed"
