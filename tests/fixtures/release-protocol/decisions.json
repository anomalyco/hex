    {
      "name": "wrong channel",
      "input": {
        "app": "example",
        "artifact": "desktop",
        "channel": "beta",
        "manifest": "base",
        "install": {
          "target": "macos-arm64",
          "distribution": "direct",
          "rollout_bucket": 0,
