<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="setup_welcome_detail">Hex Preview 只在下载语音模型（190 MB）、向 GitHub 检查更新，以及你点按“发送”提交反馈时使用网络。你的声音和文字都保留在这台设备上。</string>
