<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Hex Preview only: installing its own updates (each after the person taps Update) and saying the
         download's size first on mobile data. The Play build has none of these. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 14+: the download the person started keeps going when they leave Hex Preview (UpdateJob). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <application>
        <receiver android:name="ly.anoma.hex.updates.UpdateReceiver" android:exported="false" />
        <service android:name="ly.anoma.hex.updates.UpdateJob" android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- As in release: baseline profiles still install; the shell's benchmark receiver is unnecessary. -->
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />
    </application>
</manifest>
