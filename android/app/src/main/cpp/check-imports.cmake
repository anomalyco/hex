# Fails the build if a native library imports a call that starts, replaces or traces a process, or loads a shared
# object, or exports anything but JNI entry points.
execute_process(COMMAND "${NM}" -D --undefined-only "${LIB}" OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
foreach(name fork execlp execve prctl dlopen system)
    if(imports MATCHES " U ${name}(@|\n)")
        message(FATAL_ERROR "${LIB} imports ${name}")
    endif()
endforeach()
execute_process(COMMAND "${NM}" -D --defined-only "${LIB}" OUTPUT_VARIABLE exports COMMAND_ERROR_IS_FATAL ANY)
string(REGEX REPLACE "\n$" "" exports "${exports}")
string(REPLACE "\n" ";" exports "${exports}")
foreach(line IN LISTS exports)
    if(NOT line MATCHES " (Java_[A-Za-z0-9_]+|JNI_OnLoad|JNI_OnUnload)(@|$)")
        message(FATAL_ERROR "${LIB} exports more than JNI entry points: ${line}")
    endif()
endforeach()
