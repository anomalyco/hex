+        auto * set_threadpool = reg ? (void (*)(ggml_backend_t, ggml_threadpool_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool") : nullptr;
+        if (set_threadpool) {
+            set_threadpool(backend, threadpool);
+        }
+    }
