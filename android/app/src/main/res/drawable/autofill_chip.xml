<?xml version="1.0" encoding="utf-8"?>
<!-- A password manager's suggestion chip in the strip (Labs › Keyboard › Password manager
     suggestions): a pill the keyboard tints with its own key colour, so the chip's text always
     sits on Hex's background and never on a white default one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="15dp" />
</shape>
