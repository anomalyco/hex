{
  "name": "@hex-ai/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.97 <5.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@hex-ai/service-darwin-arm64": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "effect": "4.0.0-beta.97",
    "typescript": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
