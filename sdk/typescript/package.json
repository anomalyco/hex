{
  "name": "@kitlangton/hex",
  "version": "0.1.0",
  "description": "TypeScript client for the HEX local transcription service",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/hex.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.97 <5.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "effect": "4.0.0-beta.97",
    "typescript": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
