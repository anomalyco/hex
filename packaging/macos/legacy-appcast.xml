<?xml version="1.0" encoding="utf-8"?>
<!--
  The final appcast for Macs still running Hex 2.3.1 or earlier
  (com.kitlangton.hex2, Sparkle), served at https://anoma.ly/hex/files/appcast.xml,
  where Kit's old hosts redirect. anomaly.hex is effectively a new app, so
  those installs get one informational update: Sparkle shows these notes and
  a button to https://anoma.ly/hex, and never downloads or installs anything.
  The item has no enclosure and 2.3.1 does not set SURequireSignedFeed, so no
  Sparkle EdDSA key is needed. The version is the anomaly.hex release
  current when it was published (3.3.0); sparkle:version is CFBundleVersion
  (major*10000 + minor*100 + patch) and must exceed 2.3.1's 20301.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Hex</title>
    <link>https://anoma.ly/hex</link>
    <description>Hex has moved to Anomaly.</description>
    <language>en</language>
    <item>
      <title>Hex 3.3.0</title>
      <pubDate>Mon, 02 Nov 2026 17:00:00 +0000</pubDate>
      <sparkle:version>30300</sparkle:version>
      <sparkle:shortVersionString>3.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
      <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
      <sparkle:informationalUpdate></sparkle:informationalUpdate>
      <link>https://anoma.ly/hex</link>
      <description><![CDATA[
        <h2>The new Hex is here</h2>
        <p>Install it fresh from <a href="https://anoma.ly/hex">anoma.ly/hex</a>.</p>
        <p>It's a new app, so you'll set it up again: allow Microphone and
        Accessibility, then pick a speech model and your shortcut. Quit this
        one first.</p>
        <p>This version won't get any more updates.</p>
      ]]></description>
    </item>
  </channel>
</rss>
