<?xml version="1.0" encoding="utf-8"?>
<!--
  The final appcast for Macs still running Hex 2.3.1 or earlier
  (com.kitlangton.hex2, Sparkle). anomaly.hex is effectively a new app, so
  those installs get one informational update: Sparkle shows these notes and
  a button to https://anoma.ly/hex, and never downloads or installs anything.
  The item has no enclosure and 2.3.1 does not set SURequireSignedFeed, so no
  Sparkle EdDSA key is needed. The version is the anomaly.hex release
  current when it was published (3.1.2); sparkle:version is CFBundleVersion
  (major*10000 + minor*100 + patch) and must exceed 2.3.1's 20301.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Hex</title>
    <link>https://anoma.ly/hex</link>
    <description>Hex has moved to Anomaly.</description>
    <language>en</language>
    <item>
      <title>Hex 3.1.2</title>
      <pubDate>Sun, 01 Nov 2026 20:00:00 +0000</pubDate>
      <sparkle:version>30102</sparkle:version>
      <sparkle:shortVersionString>3.1.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
      <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
      <sparkle:informationalUpdate></sparkle:informationalUpdate>
      <link>https://anoma.ly/hex</link>
      <description><![CDATA[
        <h2>The new Hex is here</h2>
        <p>Rebuilt from the ground up, and it updates itself from now on.
        Get it at <a href="https://anoma.ly/hex">anoma.ly/hex</a>.</p>
        <ul>
        <li>A new settings window and recording indicator</li>
        <li>Vocabulary: names and terms Hex spells right</li>
        <li>About 160 MB of memory instead of 900 MB</li>
        <li>New speech models, with accuracy shown in the picker</li>
        <li>No Input Monitoring permission</li>
        </ul>
        <p>It's a new app: quit this one, drag the new Hex to Applications,
        and allow Microphone and Accessibility again. It starts fresh, so
        you pick a speech model and your shortcut once more.</p>
        <p>This version won't get further updates.</p>
      ]]></description>
    </item>
  </channel>
</rss>
